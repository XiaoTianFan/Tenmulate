{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/:page(quick-practice|drills|editor|video-comparison)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/quick-practice", "destination": "/index.html" },
    { "source": "/drills", "destination": "/index.html" },
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/video-comparison", "destination": "/index.html" }
  ]
}
